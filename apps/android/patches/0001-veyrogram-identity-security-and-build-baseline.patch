diff --git a/wkbase/src/test/java/app/veyrogram/base/JsonCompatTest.java b/wkbase/src/test/java/app/veyrogram/base/JsonCompatTest.java
new file mode 100644
index 0000000..7cea969
--- /dev/null
+++ b/wkbase/src/test/java/app/veyrogram/base/JsonCompatTest.java
@@ -0,0 +1,29 @@
+package app.veyrogram.base;
+
+import static org.junit.Assert.assertEquals;
+
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONArray;
+import com.alibaba.fastjson.JSONObject;
+
+import org.junit.Test;
+
+/** Exercises the com.alibaba.fastjson API surface the upstream modules use, on the fastjson2 compat layer. */
+public class JsonCompatTest {
+    @Test
+    public void parseObjectAndArray() {
+        JSONObject o = JSON.parseObject("{\"uid\":\"u1\",\"n\":3,\"tags\":[\"a\",\"b\"]}");
+        assertEquals("u1", o.getString("uid"));
+        assertEquals(3, o.getIntValue("n"));
+        JSONArray tags = o.getJSONArray("tags");
+        assertEquals(2, tags.size());
+        assertEquals("b", tags.getString(1));
+    }
+
+    @Test
+    public void roundTrip() {
+        JSONObject o = new JSONObject();
+        o.put("k", "v");
+        assertEquals("v", JSON.parseObject(o.toJSONString()).getString("k"));
+    }
+}
