+/** Guards against re-introducing vendor push credentials into the source tree. */
+public class PushKeysTest {
+    @Test
+    public void vendorPushCredentialsAreEmpty() {
+        assertEquals("", PushKeys.xiaoMiAppID);
+        assertEquals("", PushKeys.xiaoMiAppKey);
+        assertEquals("", PushKeys.huaweiAPPID);
+        assertEquals("", PushKeys.oppoAppKey);
+        assertEquals("", PushKeys.oppoAppSecret);
+    }
+}
