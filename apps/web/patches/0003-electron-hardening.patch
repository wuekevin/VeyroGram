diff --git a/apps/web/src-election/main/security.ts b/apps/web/src-election/main/security.ts
new file mode 100644
index 0000000..6044522
--- /dev/null
+++ b/apps/web/src-election/main/security.ts
@@ -0,0 +1,87 @@
+// VeyroGram Electron hardening (Story 1.10). Every BrowserWindow uses secureWebPreferences(); installSecurityHandlers()
+// denies navigation away from the app, denies window.open, and limits permission requests.
+import { app, ipcMain, session, shell } from "electron";
+
+export function secureWebPreferences(preload: string): Electron.WebPreferences {
+  return {
+    preload,
+    contextIsolation: true,
+    nodeIntegration: false,
+    nodeIntegrationInWorker: false,
+    nodeIntegrationInSubFrames: false,
+    sandbox: true,
+    webSecurity: true,
+    allowRunningInsecureContent: false,
+    webviewTag: false,
+  };
+}
+
+const DEV_ORIGIN = "http://localhost:3000";
+
+// The only content a window may show: the packaged build (file:) or, in development only, the dev server.
+export function isAppUrl(url: string, development = process.env.NODE_ENV === "development"): boolean {
+  try {
+    const u = new URL(url);
+    if (u.protocol === "file:") return true;
+    return development && u.origin === DEV_ORIGIN;
+  } catch {
+    return false;
+  }
+}
+
+// External links open in the system browser, https only.
+export function isSafeExternalUrl(url: string): boolean {
+  try {
+    return new URL(url).protocol === "https:";
+  } catch {
+    return false;
+  }
+}
+
+const ALLOWED_PERMISSIONS = new Set(["media", "notifications", "clipboard-sanitized-write", "fullscreen"]);
+
+export function installSecurityHandlers(): void {
+  app.on("web-contents-created", (_event, contents) => {
+    contents.on("will-navigate", (e, url) => {
+      if (!isAppUrl(url)) {
+        e.preventDefault();
+        if (isSafeExternalUrl(url)) void shell.openExternal(url);
+      }
+    });
+    contents.setWindowOpenHandler(({ url }) => {
+      if (isSafeExternalUrl(url)) void shell.openExternal(url);
+      return { action: "deny" };
+    });
+    contents.on("will-attach-webview", (e) => e.preventDefault());
+  });
+
+  const apply = () => {
+    session.defaultSession.setPermissionRequestHandler((wc, permission, cb) => {
+      cb(ALLOWED_PERMISSIONS.has(permission) && isAppUrl(wc.getURL()));
+    });
+    session.defaultSession.setPermissionCheckHandler((wc, permission) =>
+      ALLOWED_PERMISSIONS.has(permission) && (wc ? isAppUrl(wc.getURL()) : false)
+    );
+  };
+  if (app.isReady()) apply();
+  else app.whenReady().then(apply);
+}
+
+// IPC handlers must check the caller: only a frame showing app content may invoke them.
+export function isTrustedSender(event: { senderFrame?: { url: string } | null }): boolean {
+  return !!event.senderFrame && isAppUrl(event.senderFrame.url);
+}
+
+export function onTrusted(channel: string, listener: (event: any, ...args: any[]) => void): void {
+  ipcMain.on(channel, (event, ...args) => {
+    if (!isTrustedSender(event)) return;
+    listener(event, ...args);
+  });
+}
+
+export function handleTrusted(channel: string, fn: (event: any, ...args: any[]) => any): void {
+  ipcMain.handle(channel, (event, ...args) => {
+    if (!isTrustedSender(event)) throw new Error("untrusted IPC sender");
+    return fn(event, ...args);
+  });
+}
