diff --git a/apps/web/src-election/test/smoke.js b/apps/web/src-election/test/smoke.js
new file mode 100644
index 0000000..27646a2
--- /dev/null
+++ b/apps/web/src-election/test/smoke.js
@@ -0,0 +1,48 @@
+// Runtime security smoke test for the hardened Electron shell (Story 1.10). Run: electron src-election/test/smoke.js
+// (after `yarn compile:electron`). Uses a hidden window with the real preload and secureWebPreferences; exits non-zero on any failure.
+const { app, BrowserWindow } = require("electron");
+const path = require("path");
+const out = path.join(__dirname, "..", "..", "out-election");
+const { secureWebPreferences, isAppUrl, isSafeExternalUrl } = require(path.join(out, "main", "security.js"));
+
+const results = [];
+const check = (name, ok, detail = "") => { results.push({ name, ok }); console.log(`${ok ? "PASS" : "FAIL"} ${name}${detail ? " - " + detail : ""}`); };
+
+app.whenReady().then(async () => {
+  const prefs = secureWebPreferences(path.join(out, "preload", "index.js"));
+  check("webPreferences: contextIsolation on", prefs.contextIsolation === true);
+  check("webPreferences: nodeIntegration off", prefs.nodeIntegration === false);
+  check("webPreferences: sandbox on", prefs.sandbox === true);
+  check("webPreferences: webSecurity on", prefs.webSecurity === true);
+  check("isAppUrl: file allowed", isAppUrl("file:///app/build/index.html", false));
+  check("isAppUrl: https site refused", !isAppUrl("https://evil.example/", false));
+  check("isAppUrl: dev server refused outside development", !isAppUrl("http://localhost:3000/", false));
+  check("isSafeExternalUrl: javascript: refused", !isSafeExternalUrl("javascript:alert(1)"));
+  check("isSafeExternalUrl: file: refused", !isSafeExternalUrl("file:///etc/passwd"));
+  check("isSafeExternalUrl: https allowed", isSafeExternalUrl("https://example.com/"));
+
+  const win = new BrowserWindow({ show: false, webPreferences: prefs });
+  await win.loadURL("data:text/html,<html><body>smoke</body></html>");
+  const run = (code) => win.webContents.executeJavaScript(code);
+  check("renderer: require is undefined", (await run("typeof require")) === "undefined");
+  check("renderer: process is undefined", (await run("typeof process")) === "undefined");
+  check("renderer: preload exposes ipc", (await run("typeof window.ipc?.send")) === "function");
+  check("renderer: allowed channel accepted", (await run("(()=>{try{window.ipc.send('check-update');return 'ok'}catch(e){return e.message}})()")) === "ok");
+  check("renderer: unknown send channel refused", /not allowed/.test(await run("(()=>{try{window.ipc.send('shell-exec','x');return 'sent'}catch(e){return e.message}})()")));
+  check("renderer: unknown invoke channel rejected", /not allowed/.test(await run("window.ipc.invoke('read-file','/etc/passwd').then(()=>'ok',e=>e.message)")));
+  check("renderer: unknown receive channel refused", /not allowed/.test(await run("(()=>{try{window.ipc.on('secret',()=>{});return 'ok'}catch(e){return e.message}})()")));
+
+  require(path.join(out, "main", "security.js")).installSecurityHandlers();
+  const w2 = new BrowserWindow({ show: false, webPreferences: prefs });
+  await w2.loadURL("data:text/html,<html><body>x</body></html>");
+  await w2.webContents.executeJavaScript("location.href='https://evil.example/'").catch(() => {});
+  await new Promise((r) => setTimeout(r, 800));
+  check("navigation away from app content blocked", w2.webContents.getURL().startsWith("data:"), w2.webContents.getURL());
+  const popup = await w2.webContents.executeJavaScript("window.open('https://evil.example/') === null");
+  check("window.open denied", popup === true);
+  check("only the original windows exist (no popup)", BrowserWindow.getAllWindows().length === 2);
+
+  const failed = results.filter((r) => !r.ok).length;
+  console.log(failed ? `${failed} FAILED` : `all ${results.length} passed`);
+  app.exit(failed ? 1 : 0);
+});
