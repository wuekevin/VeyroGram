 #define uidKey @"uid"
 #define tokenKey @"token"
 #define imTokenKey @"imtoken"
@@ -20,6 +21,38 @@ @interface WKLoginInfo ()
 
 @end
 
+
+// Session tokens live in the Keychain, readable only after first unlock and never migrated to another device or into a backup.
+static NSString *const VGKeychainService = @"com.veyrogram.logininfo";
+static NSString *const VGInstallMarkerKey = @"vg.installMarker";
+
+static NSMutableDictionary *VGKeychainQuery(void) {
+    return [@{(__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
+              (__bridge id)kSecAttrService: VGKeychainService,
+              (__bridge id)kSecAttrAccount: @"loginInfo"} mutableCopy];
+}
+
+static NSData *VGKeychainRead(void) {
+    NSMutableDictionary *q = VGKeychainQuery();
+    q[(__bridge id)kSecReturnData] = @YES;
+    q[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
+    CFTypeRef out = NULL;
+    if (SecItemCopyMatching((__bridge CFDictionaryRef)q, &out) != errSecSuccess || !out) return nil;
+    return (__bridge_transfer NSData *)out;
+}
+
+static void VGKeychainDelete(void) {
+    SecItemDelete((__bridge CFDictionaryRef)VGKeychainQuery());
+}
+
+static BOOL VGKeychainWrite(NSData *data) {
+    VGKeychainDelete();
+    NSMutableDictionary *q = VGKeychainQuery();
+    q[(__bridge id)kSecValueData] = data;
+    q[(__bridge id)kSecAttrAccessible] = (__bridge id)kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly;
+    return SecItemAdd((__bridge CFDictionaryRef)q, NULL) == errSecSuccess;
+}
+
 @implementation WKLoginInfo
 
 
