+    NSData *data = VGKeychainRead();
+    if (!data) {
+        // Migrate a session saved by an older build out of the (backed-up) user defaults.
+        NSData *legacy = [userDefaults objectForKey:LoginInfoKey];
+        if (legacy && VGKeychainWrite(legacy)) {
+            data = legacy;
+        }
+    }
+    [userDefaults removeObjectForKey:LoginInfoKey];
