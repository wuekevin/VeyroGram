+package webhook
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/WuKongIM/WuKongIM/pkg/webhooksig"
+)
+
+func TestHTTPSenderSignsOnlyWhenConfigured(t *testing.T) {
+	var ts, sig string
+	var body []byte
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ts, sig = r.Header.Get(webhooksig.HeaderTimestamp), r.Header.Get(webhooksig.HeaderSignature)
+		body, _ = io.ReadAll(r.Body)
+	}))
+	defer srv.Close()
+	req := SendRequest{Event: "msg.notify", Body: []byte(`[{"x":1}]`)}
+
+	if err := NewHTTPSender(HTTPSenderOptions{Addr: srv.URL, Timeout: time.Second, SigningSecret: "unit-test-secret-0123456789"}).Send(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if !webhooksig.Verify("unit-test-secret-0123456789", ts, sig, body, time.Now(), time.Minute) {
+		t.Fatalf("signature does not verify: ts=%q sig=%q", ts, sig)
+	}
+	if err := NewHTTPSender(HTTPSenderOptions{Addr: srv.URL, Timeout: time.Second}).Send(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if ts != "" || sig != "" {
+		t.Fatalf("without a secret the request must stay unsigned (backward compatible), got %q %q", ts, sig)
+	}
+}
diff --git a/pkg/webhooksig/webhooksig.go b/pkg/webhooksig/webhooksig.go
new file mode 100644
index 0000000..532fa46
--- /dev/null
+++ b/pkg/webhooksig/webhooksig.go
@@ -0,0 +1,53 @@
+// Package webhooksig signs outbound webhook requests so a receiver can authenticate WuKongIM and reject replays.
+//
+// Scheme (VeyroGram patch): X-WK-Timestamp = unix seconds; X-WK-Signature = "v1=" + hex(HMAC-SHA256(secret, timestamp + "." + body)).
+// Receivers must compare in constant time and reject timestamps outside a small window.
+package webhooksig
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+const (
+	HeaderTimestamp = "X-WK-Timestamp"
+	HeaderSignature = "X-WK-Signature"
+	version         = "v1="
+)
+
+// Sign returns the signature header value for body at ts.
+func Sign(secret string, ts time.Time, body []byte) (timestamp, signature string) {
+	timestamp = strconv.FormatInt(ts.Unix(), 10)
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte(timestamp))
+	mac.Write([]byte("."))
+	mac.Write(body)
+	return timestamp, version + hex.EncodeToString(mac.Sum(nil))
+}
+
+// Apply sets both headers on req when secret is non-empty; with an empty secret it leaves the request unsigned.
+func Apply(req *http.Request, secret string, now time.Time, body []byte) {
+	if secret == "" {
+		return
+	}
+	ts, sig := Sign(secret, now, body)
+	req.Header.Set(HeaderTimestamp, ts)
+	req.Header.Set(HeaderSignature, sig)
+}
+
+// Verify checks signature for body within maxSkew of now, in constant time.
+func Verify(secret, timestamp, signature string, body []byte, now time.Time, maxSkew time.Duration) bool {
+	sec, err := strconv.ParseInt(timestamp, 10, 64)
+	if err != nil || secret == "" {
+		return false
+	}
+	if d := now.Sub(time.Unix(sec, 0)); d > maxSkew || d < -maxSkew {
+		return false
+	}
+	_, want := Sign(secret, time.Unix(sec, 0), body)
+	return hmac.Equal([]byte(want), []byte(signature))
+}
diff --git a/pkg/webhooksig/webhooksig_test.go b/pkg/webhooksig/webhooksig_test.go
new file mode 100644
index 0000000..932bf9f
--- /dev/null
+++ b/pkg/webhooksig/webhooksig_test.go
@@ -0,0 +1,41 @@
+package webhooksig
+
+import (
+	"net/http"
+	"testing"
+	"time"
+)
+
+func TestSignVerifyRoundTripAndTamperDetection(t *testing.T) {
+	now := time.Unix(1_800_000_000, 0)
+	body := []byte(`{"a":1}`)
+	ts, sig := Sign("s3cret-s3cret-s3cret", now, body)
+	if !Verify("s3cret-s3cret-s3cret", ts, sig, body, now, time.Minute) {
+		t.Fatal("valid signature rejected")
+	}
+	for name, ok := range map[string]bool{
+		"wrong secret": Verify("other", ts, sig, body, now, time.Minute),
+		"tampered":     Verify("s3cret-s3cret-s3cret", ts, sig, []byte(`{"a":2}`), now, time.Minute),
+		"replay":       Verify("s3cret-s3cret-s3cret", ts, sig, body, now.Add(2*time.Minute), time.Minute),
+		"future":       Verify("s3cret-s3cret-s3cret", ts, sig, body, now.Add(-2*time.Minute), time.Minute),
+		"bad ts":       Verify("s3cret-s3cret-s3cret", "x", sig, body, now, time.Minute),
+		"empty secret": Verify("", ts, sig, body, now, time.Minute),
+		"ts swapped":   Verify("s3cret-s3cret-s3cret", "1800000001", sig, body, now, time.Minute),
+	} {
+		if ok {
+			t.Errorf("%s must be rejected", name)
+		}
+	}
+}
+
+func TestApplyLeavesRequestUnsignedWithoutSecret(t *testing.T) {
+	r, _ := http.NewRequest(http.MethodPost, "http://x", nil)
+	Apply(r, "", time.Now(), nil)
+	if r.Header.Get(HeaderSignature) != "" || r.Header.Get(HeaderTimestamp) != "" {
+		t.Fatal("no secret => no headers")
+	}
+	Apply(r, "k", time.Unix(5, 0), []byte("b"))
+	if r.Header.Get(HeaderTimestamp) != "5" || r.Header.Get(HeaderSignature)[:3] != "v1=" {
+		t.Fatalf("headers: %v", r.Header)
+	}
+}
