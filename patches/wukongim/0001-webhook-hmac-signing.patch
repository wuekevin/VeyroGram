@@ -0,0 +1,46 @@
+package webhook
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/WuKongIM/WuKongIM/internal/usecase/message"
+	"github.com/WuKongIM/WuKongIM/pkg/webhooksig"
+)
+
+func TestBeforeSendClientSignsTheExactBodyItSends(t *testing.T) {
+	var ts, sig string
+	var body []byte
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ts, sig = r.Header.Get(webhooksig.HeaderTimestamp), r.Header.Get(webhooksig.HeaderSignature)
+		body, _ = io.ReadAll(r.Body)
+		_, _ = w.Write([]byte(`{"allow":true}`))
+	}))
+	defer srv.Close()
+	c, err := NewBeforeSendClient(srv.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := message.BeforeSendRequest{FromUID: "u1", ChannelID: "c1", ChannelType: 2, ClientMsgNo: "m1", Payload: []byte("hi")}
+	if _, err := c.WithSigningSecret("unit-test-secret-0123456789").BeforeSend(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if !webhooksig.Verify("unit-test-secret-0123456789", ts, sig, body, time.Now(), time.Minute) {
+		t.Fatalf("signature does not verify against the sent body: ts=%q sig=%q", ts, sig)
+	}
+	if webhooksig.Verify("other-secret-other-secret-00000", ts, sig, body, time.Now(), time.Minute) {
+		t.Fatal("a different secret must not verify")
+	}
+	c2, _ := NewBeforeSendClient(srv.URL, nil)
+	ts, sig = "", ""
+	if _, err := c2.BeforeSend(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if ts != "" || sig != "" {
+		t.Fatal("unsigned when no secret is configured")
+	}
+}
