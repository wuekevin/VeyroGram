# Settings for the WuKongIM snapshot (veyrogram-backup-im.service, which runs as the IM account). Install to /etc/veyrogram/backup-im.env (root:veyrogram-im 0640).
# It is a separate file on purpose: the IM account gets its own, append-only upload credential and never sees the database backup settings.
VG_BACKUP_DIR=/var/backups/veyrogram-im
VG_BACKUP_BIN=/opt/veyrogram/api/current/veyrogram-api
VG_BACKUP_PUBKEY=/etc/veyrogram/backup-public.pem
VG_BACKUP_UPLOAD_CMD=
VG_BACKUP_REQUIRE_OFFHOST=1
VG_BACKUP_METRICS=/var/lib/node_exporter/textfile_collector/veyrogram_backup_im.prom
VG_BACKUP_RETENTION_DAYS=7

# WuKongIM snapshot. stop = stop the IM for the length of one local copy of its data directory, then start it again (verified procedure).
# none = you freeze the filesystem or snapshot the volume yourself and mount it at VG_IM_DATA_DIR; nothing is stopped.
VG_IM_DATA_DIR=/var/lib/veyrogram-im/data
VG_IM_QUIESCE=stop
