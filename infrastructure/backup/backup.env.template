# VeyroGram backup settings. Install to /etc/veyrogram/backup.env (root:veyrogram-backup 0640). install.sh places this template there once; it needs values only you have.
# Parsed line by line (never sourced); only VG_BACKUP_* and VG_IM_* names are read.

# Where encrypted artifacts are staged on this host before and after shipping (created 0700).
VG_BACKUP_DIR=/var/backups/veyrogram
# PUBLIC key made with `veyrogram-api backup keygen -out-dir <dir>` on YOUR machine. The private key must never be on this host.
VG_BACKUP_PUBKEY=/etc/veyrogram/backup-public.pem
# Ship command, called as: bash -c "$VG_BACKUP_UPLOAD_CMD" _ <file>   ($1 is the file). Must put it OFF this host (another machine or an object store), e.g.
#   VG_BACKUP_UPLOAD_CMD='rclone copyto "$1" remote:veyrogram-backups/$(basename "$1")'      or      VG_BACKUP_UPLOAD_CMD='scp -q "$1" backup@offsite:/srv/veyrogram/'
# Use credentials that can ADD objects but not delete or overwrite them (append-only), so a compromised host cannot erase its own history.
# Single-quote the value: systemd reads this file too, and would otherwise mangle the inner double quotes.
VG_BACKUP_UPLOAD_CMD=
# 1 = a run without VG_BACKUP_UPLOAD_CMD fails (the default). 0 only for rehearsals.
VG_BACKUP_REQUIRE_OFFHOST=1
# my.cnf-style file holding the backup account ([client] host/user/password/socket); 0600. Create the account with `veyrogram-api db provision -backup-user`.
VG_BACKUP_MYSQL_DEFAULTS=/etc/veyrogram/backup-mysql.cnf
VG_BACKUP_DATABASE=veyrogram
# Local copies that were shipped are deleted after this many days.
VG_BACKUP_RETENTION_DAYS=7
# Prometheus textfile (node_exporter textfile collector): last success/failure time and size per kind.
VG_BACKUP_METRICS=/var/lib/node_exporter/textfile_collector/veyrogram_backup.prom
