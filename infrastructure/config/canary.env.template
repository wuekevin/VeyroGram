# Overrides for the canary instance (loaded after api.env by veyrogram-api-canary.service). Install to /etc/veyrogram/canary.env, root:veyrogram 0640.
# Every listener gets its own address so the canary can run beside the live API; the admin plane stays on the live instance only.
VG_HTTP_ADDR=127.0.0.1:8081
VG_INTERNAL_ADDR=127.0.0.1:9111
VG_IM_WEBHOOK_ADDR=127.0.0.1:9112
VG_WORKER_INTERNAL_ADDR=127.0.0.1:9114
VG_MANAGER_ENABLED=false
