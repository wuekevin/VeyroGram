# VeyroGram API — DEVELOPMENT environment file (template). Local machine only; weak defaults are tolerated here and refused everywhere else.
VG_ENV=development
VG_HTTP_ADDR=127.0.0.1:8080
VG_INTERNAL_ADDR=127.0.0.1:9101
VG_MYSQL_DSN=veyrogram_dev:@@GEN:URLSAFE32@@@tcp(127.0.0.1:3306)/veyrogram_dev?parseTime=true&charset=utf8mb4
VG_REDIS_ADDR=127.0.0.1:6379
VG_IM_API_URL=http://127.0.0.1:5001
VG_AUTH_SMS_LOGIN=true
VG_TOKEN_KEYS=dev1:@@GEN:B64URL32@@
VG_PHONE_HASH_KEY=@@GEN:HEX32@@
VG_IM_TOKEN_KEY=@@GEN:HEX32@@
# The log provider prints verification codes to the service log. Never use it outside development/test.
VG_SMS_PROVIDER=log
VG_ADMIN_TOTP_KEY=@@GEN:HEX32@@
