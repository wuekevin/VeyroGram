# VeyroGram API — STAGING environment file (template).
# Staging shares nothing with production: its own database, Redis instance, IM node, ports and secrets. On the same host the ports above are offset by 10000;
# on a separate host you may keep the production ports (host split: PRD OQ-7, still open).
# install.sh renders this to /etc/veyrogram/api.env (root:veyrogram, 0640) and NEVER overwrites an existing file.
#   a GEN marker is replaced with a fresh random value on the host; the value is never printed and never leaves the host.
#   a FILL marker must be filled by you (it is an account or address only you know). The service refuses to start while any remain.
# Separate files exist for development, test and staging: never reuse a secret across environments.
VG_ENV=staging

# --- listeners (all loopback; Nginx is the only public entry, see infrastructure/nginx) ---
VG_HTTP_ADDR=127.0.0.1:18080
VG_INTERNAL_ADDR=127.0.0.1:19101
VG_IM_WEBHOOK_ADDR=127.0.0.1:19102
VG_WORKER_INTERNAL_ADDR=127.0.0.1:19104
VG_TRUSTED_PROXIES=127.0.0.1/32

# --- data stores (accounts and grants: `veyrogram-api db provision`; least privilege, see infrastructure/mysql/README.md) ---
# DSN form: ACCOUNT:PASSWORD at tcp(127.0.0.1:3306)/veyrogram_staging?parseTime=true&charset=utf8mb4  (write the at-sign between the password and tcp)
# Use a database and account of its own: staging never shares a schema with production.
VG_MYSQL_DSN=@@FILL:database DSN of the application account@@
VG_REDIS_ADDR=127.0.0.1:6380
VG_REDIS_PASSWORD=@@GEN:URLSAFE32@@

# --- instant messaging (WuKongIM stays on loopback; only its gateway listeners are public) ---
VG_IM_API_URL=http://127.0.0.1:15001
VG_IM_TOKEN_KEY=@@GEN:HEX32@@
VG_IM_WEBHOOK_SECRET=@@GEN:URLSAFE32@@
VG_IM_WEBHOOK_SIGNING_SECRET=@@GEN:URLSAFE32@@

# --- accounts and login ---
VG_AUTH_SMS_LOGIN=true
VG_TOKEN_KEYS=k1:@@GEN:B64URL32@@
# Reserved: still required by the configuration check in staging/production although access tokens are signed with the keys above.
VG_TOKEN_SIGNING_KEY=@@GEN:HEX32@@
VG_PHONE_HASH_KEY=@@GEN:HEX32@@
VG_SMS_PROVIDER=smsbao
VG_SMSBAO_USER=@@FILL:SMS provider account@@
VG_SMSBAO_KEY=@@FILL:SMS provider API key@@

# --- operations ---
VG_METRICS_TOKEN=@@GEN:URLSAFE32@@
VG_MESSAGE_RATE_LIMIT=30
VG_MESSAGE_RATE_WINDOW_SECONDS=10

# --- admin plane: off until you have followed docs/ops/MANUAL-CHECKLIST.md section C7 (own hostname, allowlist or VPN) ---
VG_MANAGER_ENABLED=false
VG_MANAGER_ADDR=127.0.0.1:19103
VG_ADMIN_TOTP_KEY=@@GEN:HEX32@@
