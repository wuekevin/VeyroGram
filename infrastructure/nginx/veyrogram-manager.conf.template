# VeyroGram admin plane — Nginx site template (ARCHITECTURE AD-24): its OWN hostname, certificate and upstream; it shares nothing with the user API site.
# Only /v1/manager/ is forwarded; everything else is 404. Render with infrastructure/scripts/render-nginx.sh (UPSTREAM = the manager listener, 127.0.0.1:9103).
# Restrict who can even reach the hostname with the optional allow/deny lines below (VPN/office ranges), in addition to VG_MANAGER_ALLOW in the API.
upstream veyrogram_manager {
    server ${UPSTREAM};
    keepalive 8;
}

server {
    listen ${LISTEN} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store" always;

    # allow 203.0.113.0/24;   # office / VPN range: uncomment and edit, then keep "deny all"
    # deny all;

    # Nginx is the edge hop, so client-supplied forwarding headers are overwritten, not appended.
    location ^~ /v1/manager/ {
        proxy_pass http://veyrogram_manager;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
