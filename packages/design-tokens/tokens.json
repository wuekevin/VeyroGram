{
  "$schema": "VeyroGram design tokens v0.1 (draft; single source for all clients, AD-17)",
  "brand": {
    "ink-950": "#020B2A",
    "ink-900": "#0A2159",
    "cyan-400": "#19E2FC",
    "cyan-300": "#00EAFD",
    "azure-500": "#00BBFE",
    "blue-400": "#2AB0FD",
    "indigo-500": "#6171FE",
    "violet-600": "#4E2ED6",
    "violet-500": "#8548FC",
    "magenta-400": "#E458FE"
  },
  "gradient": {
    "brand": "linear-gradient(135deg,#00EAFD 0%,#2AB0FD 35%,#6171FE 65%,#8548FC 100%)",
    "brand-accent-end": "#E458FE",
    "action": "linear-gradient(135deg,#00EAFD 0%,#2AB0FD 50%,#6171FE 100%)",
    "action-stops": [
      "#00EAFD",
      "#2AB0FD",
      "#6171FE"
    ],
    "note": "`brand` (full, to violet) is decorative or for LARGE text/graphics only; `action` is the only gradient allowed behind normal-size text (navy text, min 4.5:1 on every stop)."
  },
  "theme": {
    "light": {
      "bg-canvas": "#F4F7FF",
      "surface": "#FFFFFF",
      "surface-sunken": "#E8EEFF",
      "border": "#CFD8F2",
      "text-primary": "#0A1230",
      "text-secondary": "#46527A",
      "text-disabled": "#8A94B8",
      "primary": "#4E2ED6",
      "on-primary": "#FFFFFF",
      "primary-subtle": "#E6E0FF",
      "link": "#3B27B8",
      "focus-ring": "#0066CC",
      "success": "#0E7A4B",
      "warning": "#8A5A00",
      "danger": "#C42B31",
      "info": "#005FA3",
      "bubble-out": "#4E2ED6",
      "on-bubble-out": "#FFFFFF",
      "bubble-in": "#FFFFFF",
      "on-bubble-in": "#0A1230",
      "text-placeholder": "#5B6690",
      "border-strong": "#7C88B3",
      "on-bubble-out-secondary": "#DCD4FF",
      "on-bubble-in-secondary": "#46527A"
    },
    "dark": {
      "bg-canvas": "#020B2A",
      "surface": "#0A1840",
      "surface-sunken": "#050F33",
      "border": "#1E2E66",
      "text-primary": "#EAF1FF",
      "text-secondary": "#A5B2DA",
      "text-disabled": "#5E6C9E",
      "primary": "#2AB0FD",
      "on-primary": "#020B2A",
      "primary-subtle": "#0F2A66",
      "link": "#6FD0FF",
      "focus-ring": "#19E2FC",
      "success": "#3DDC97",
      "warning": "#FFC24D",
      "danger": "#FF7A80",
      "info": "#5CC8FF",
      "bubble-out": "#2AB0FD",
      "on-bubble-out": "#020B2A",
      "bubble-in": "#10225A",
      "on-bubble-in": "#EAF1FF",
      "text-placeholder": "#8A98C6",
      "border-strong": "#5C70B3",
      "on-bubble-out-secondary": "#0A2A5C",
      "on-bubble-in-secondary": "#A5B2DA"
    }
  },
  "typography": {
    "font-sans": "Inter, 'Noto Sans SC', system-ui, sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, monospace",
    "scale": {
      "display": {
        "size": 32,
        "line": 40,
        "weight": 700
      },
      "title-1": {
        "size": 24,
        "line": 32,
        "weight": 700
      },
      "title-2": {
        "size": 20,
        "line": 28,
        "weight": 600
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "body-sm": {
        "size": 14,
        "line": 20,
        "weight": 400
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 500
      }
    },
    "note": "Fonts are [ASSUMPTION] open-licensed (OFL) defaults; mobile apps use platform fonts with Dynamic Type/sp scaling."
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "radius": {
    "sm": 6,
    "md": 12,
    "lg": 20,
    "xl": 28,
    "bubble": 18,
    "full": 9999
  },
  "elevation": {
    "e1": "0 1px 2px rgba(2,11,42,.12)",
    "e2": "0 4px 12px rgba(2,11,42,.16)",
    "e3": "0 12px 32px rgba(2,11,42,.24)"
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "cubic-bezier(.2,0,0,1)",
    "reduced-motion": "replace transforms with fades; no parallax"
  },
  "breakpoints": {
    "phone": 0,
    "tablet": 600,
    "desktop": 960,
    "wide": 1440
  },
  "touch-target-min": {
    "android-dp": 48,
    "ios-pt": 44,
    "desktop-px": 32
  },
  "icon": {
    "grid": 24,
    "stroke": 1.75,
    "cap": "round",
    "join": "round",
    "live-area": 20,
    "sizes": [
      16,
      20,
      24,
      32
    ]
  },
  "contrast_rules": {
    "note": "Computed by check_contrast.py (WCAG 2.1 relative luminance). 'text' >=4.5; 'ui' (non-text UI boundaries, focus, icons) >=3.0. `border` is decorative (no requirement); input boundaries use `border-strong`.",
    "text": [
      [
        "text-primary",
        "bg-canvas"
      ],
      [
        "text-primary",
        "surface"
      ],
      [
        "text-secondary",
        "bg-canvas"
      ],
      [
        "text-secondary",
        "surface"
      ],
      [
        "text-placeholder",
        "surface"
      ],
      [
        "text-placeholder",
        "bg-canvas"
      ],
      [
        "on-primary",
        "primary"
      ],
      [
        "link",
        "surface"
      ],
      [
        "link",
        "bg-canvas"
      ],
      [
        "success",
        "surface"
      ],
      [
        "warning",
        "surface"
      ],
      [
        "danger",
        "surface"
      ],
      [
        "info",
        "surface"
      ],
      [
        "on-bubble-out",
        "bubble-out"
      ],
      [
        "on-bubble-in",
        "bubble-in"
      ],
      [
        "on-bubble-out-secondary",
        "bubble-out"
      ],
      [
        "on-bubble-in-secondary",
        "bubble-in"
      ]
    ],
    "ui": [
      [
        "focus-ring",
        "bg-canvas"
      ],
      [
        "focus-ring",
        "surface"
      ],
      [
        "primary",
        "bg-canvas"
      ],
      [
        "border-strong",
        "surface"
      ],
      [
        "border-strong",
        "bg-canvas"
      ]
    ],
    "gradient_text": [
      {
        "name": "action",
        "stops": "action-stops",
        "fg": "#020B2A",
        "min": 4.5
      },
      {
        "name": "brand-large-text",
        "stops": [
          "#00EAFD",
          "#2AB0FD",
          "#6171FE",
          "#8548FC"
        ],
        "fg_on": "#020B2A",
        "min": 3.0,
        "note": "gradient headline words (>=24px) on ink-950"
      }
    ]
  }
}